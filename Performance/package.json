{
  "name": "ebac-shop-performance-k6",
  "version": "1.0.0",
  "description": "Testes de Carga e Performance com K6 para EBAC Shop",
  "main": "index.js",
  "scripts": {
    "test:login": "k6 run scripts/login-performance.js",
    "test:login:smoke": "k6 run -e PROFILE=smoke scripts/login-performance.js",
    "test:cart": "k6 run scripts/cart-performance.js",
    "test:cart:smoke": "k6 run -e PROFILE=smoke scripts/cart-performance.js",
    "test:all": "npm run test:login && npm run test:cart",
    "docker:login": "docker run --rm -i -v \"%cd%:/app\" -w /app grafana/k6 run scripts/login-performance.js",
    "docker:cart": "docker run --rm -i -v \"%cd%:/app\" -w /app grafana/k6 run scripts/cart-performance.js"
  },
  "keywords": [
    "k6",
    "performance",
    "load-testing",
    "ebac",
    "qa"
  ],
  "author": "Leonardo de Almeida",
  "license": "ISC"
}